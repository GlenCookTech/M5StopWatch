# StopWatch wearable (ESP32-S3): octal PSRAM @ 80 MHz.
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# LVGL extras only the watch firmware uses (badge PNG/JPEG decoding, demos).
CONFIG_LV_CACHE_DEF_SIZE=1048576
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_LV_USE_DEMO_STRESS=y
CONFIG_LV_USE_DEMO_SMARTWATCH=y
